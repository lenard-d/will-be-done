{
  "compilerOptions": {
    // Environment setup & latest features
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    // "noUncheckedIndexedAccess": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false,

    // Allow missing modules for Docker builds
    "skipDefaultLibCheck": true,
    "types": [
      "bun-types"
    ],
    "paths": {
      "@will-be-done/hyperdb": [
        "../../../hyperdb/packages/hyperdb/src/index.ts"
      ],
      "@will-be-done/hyperdb/react": [
        "../../../hyperdb/packages/hyperdb/src/react.ts"
      ],
      "@will-be-done/hyperdb/tracing": [
        "../../../hyperdb/packages/hyperdb/src/hyperdb/tracing/index.ts"
      ],
      "@will-be-done/hyperdb/drivers/inmemory": [
        "../../../hyperdb/packages/hyperdb/src/hyperdb/drivers/inmemory/bptree-inmem-driver.ts"
      ],
      "@will-be-done/hyperdb/drivers/sqlite": [
        "../../../hyperdb/packages/hyperdb/src/hyperdb/drivers/sqlite/index.ts"
      ],
      "@will-be-done/hyperdb/drivers/idb": [
        "../../../hyperdb/packages/hyperdb/src/hyperdb/drivers/idb/idb-driver.ts"
      ]
    }
  },
  "include": ["src"]
}
