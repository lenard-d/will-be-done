{
  "openapi": "3.1.0",
  "info": {
    "title": "Will Be Done API",
    "description": "Public HTTP API for Will Be Done.",
    "version": "1.0.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token returned by the login or register endpoint."
      }
    },
    "schemas": {}
  },
  "paths": {
    "/api/v1/spaces/{spaceId}/projects": {
      "get": {
        "operationId": "listProjects",
        "summary": "List projects",
        "tags": ["Projects"],
        "description": "Returns the projects in a space in their display order.",
        "parameters": [
          {
            "schema": { "type": "string", "minLength": 1 },
            "in": "path",
            "name": "spaceId",
            "required": true,
            "description": "Space identifier"
          }
        ],
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Projects in display order",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "projects": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "description": "Project identifier"
                          },
                          "title": { "type": "string" },
                          "icon": { "type": "string" },
                          "isInbox": { "type": "boolean" },
                          "createdAt": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991,
                            "description": "Creation time as Unix milliseconds"
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "icon",
                          "isInbox",
                          "createdAt"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": ["projects"],
                  "additionalProperties": false,
                  "description": "Projects in display order"
                }
              }
            }
          },
          "401": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "UNAUTHORIZED",
                        "FORBIDDEN",
                        "INTERNAL_SERVER_ERROR"
                      ]
                    },
                    "message": { "type": "string" }
                  },
                  "required": ["code", "message"],
                  "additionalProperties": false,
                  "description": "Error response"
                }
              }
            }
          },
          "403": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "UNAUTHORIZED",
                        "FORBIDDEN",
                        "INTERNAL_SERVER_ERROR"
                      ]
                    },
                    "message": { "type": "string" }
                  },
                  "required": ["code", "message"],
                  "additionalProperties": false,
                  "description": "Error response"
                }
              }
            }
          },
          "500": {
            "description": "Error response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "UNAUTHORIZED",
                        "FORBIDDEN",
                        "INTERNAL_SERVER_ERROR"
                      ]
                    },
                    "message": { "type": "string" }
                  },
                  "required": ["code", "message"],
                  "additionalProperties": false,
                  "description": "Error response"
                }
              }
            }
          }
        }
      }
    }
  }
}
